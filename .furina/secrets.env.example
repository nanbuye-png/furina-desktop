# Furina Desktop 密钥文件模板（复制为 .furina/secrets.env 并填入真实值）
# Desktop 启动时会自动读取本文件并注入环境，无需每次手动设置环境变量。
# 本文件已被 .gitignore 忽略，不会上传 GitHub。

# LLM 默认提供方（DeepSeek）key
FURINA_API_KEY=

# 联网搜索（Tavily / Bing / SearXNG 任选其一，对应 config.yaml 的 web 段）
TAVILY_API_KEY=
# BING_API_KEY=

# 多模型网关：每个提供方一个 key（对应 config.yaml 的 llm.providers[].api_key_env）
# RELAY_API_KEY=
# DASHSCOPE_API_KEY=

# 可选：用环境变量覆盖提供方的端点与模型（不填则用 config.yaml 的默认值）。
# 变量名规则：<提供方ID大写>_BASE_URL / <提供方ID大写>_MODEL（非字母数字转 _）
# RELAY_BASE_URL=https://your-relay.example.com/v1
# RELAY_MODEL=gpt-4o-mini
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# 视觉模型（图片识别，config.yaml 中 vision.enabled: true 并配置 vision: true 的提供方）
# ZHIPU_API_KEY=   # GLM-4V-Flash（免费）等智谱视觉模型

# 语音合成（fish.audio TTS，config.yaml 中 voice.enabled: true 后可用）
FISH_AUDIO_API_KEY=
# 音色包 ID（鱼声平台角色音色包的 reference_id；不填则用 config.yaml 的 voice.reference_id）
FURINA_VOICE_REFERENCE_ID=
